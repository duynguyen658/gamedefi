# Backend: copy these values to backend/.env. Never put wallet private keys in environment files.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public program address from anchor keys list after deployment
SOLANA_PROGRAM_ID=8qUBTgX99v5EhxbAaxuqS94rgfRhnLrTgW66Gh9BvLKN
REWARD_AMOUNT_LAMPORTS=5000000
# PostgreSQL stores DEX intents, execution state, public signatures, and reconciliation state.
DATABASE_URL=postgresql+psycopg://gamefi:gamefi@127.0.0.1:5432/vietnam_history_gamefi
DATABASE_AUTO_CREATE=false
# Required only when SOLANA_NETWORK=mainnet-beta. Never expose this in VITE_* variables.
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag/swap/v2
DEX_MOCK_SOL_USDC_RATE=100
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend: copy the following values to frontend/.env
VITE_API_URL=http://127.0.0.1:8000
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Program ID is read from the backend /blockchain/solana/config endpoint.
