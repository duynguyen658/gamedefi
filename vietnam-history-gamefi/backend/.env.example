# Safe to commit: this file contains only public Devnet addresses and empty secret placeholders.
# Put real credentials only in backend/.env, which Git ignores.
# Backend: copy to backend/.env. Never put wallet private keys in environment files.
SOLANA_NETWORK=devnet
# PostgreSQL for persisted DEX intents, execution state, and reconciliation.
DATABASE_URL=postgresql+psycopg://gamefi:gamefi@127.0.0.1:5432/vietnam_history_gamefi
DATABASE_AUTO_CREATE=false
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public program address from anchor keys list after deployment
SOLANA_PROGRAM_ID=8qUBTgX99v5EhxbAaxuqS94rgfRhnLrTgW66Gh9BvLKN
