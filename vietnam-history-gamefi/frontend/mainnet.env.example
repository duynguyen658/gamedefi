# Copy to frontend/.env only after backend Mainnet readiness is green.
# VITE_ values are public and bundled into the browser.
VITE_API_URL=https://api.game.example.com
VITE_SOLANA_NETWORK=mainnet-beta
# Browser-visible RPC only. Never put a private provider API key in VITE_*.
VITE_SOLANA_RPC_URL=
VITE_HKDV_MINT=
